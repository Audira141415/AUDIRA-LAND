# Salin ke server/.env lalu ubah. Kalau ADMIN_TOKEN kosong, server membuatnya otomatis.
PORT=5173
# Lokal: 127.0.0.1. Produksi di belakang Caddy/Nginx: tetap 127.0.0.1 (proxy yang membuka ke internet).
HOST=127.0.0.1
# jarak antar kapal (detik, minimal 30) dan kursi per kapal. Produksi: 300 / 12.
FERRY_EVERY_S=300
FERRY_CAP=12
ADMIN_TOKEN=

# Produksi di belakang reverse proxy: 1 = batas permintaan per IP memakai X-Forwarded-For dari proxy.
# Biarkan 0 bila server langsung terbuka ke internet (header itu bisa dipalsukan).
TRUST_PROXY=0
# jumlah cadangan harian database yang disimpan di server/data/backup/
BACKUP_KEEP=14
# 1 = izinkan server jalan walau js/world.js berubah setelah ada warga (rumah, kerja & gaji warga ikut bergeser).
# Pakai sekali saja kalau memang disengaja, lalu kembalikan ke 0.
IZINKAN_UBAH_PETA=0
